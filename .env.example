# Shared secret used to verify incoming webhook signatures
WEBHOOK_SECRET=your-shared-secret-here

# n8n webhook URL — the "Webhook" node URL from your n8n workflow
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/YOUR_WEBHOOK_ID

# Optional: Cloudflare KV namespace binding for idempotency dedup (set in wrangler.toml)
# IDEMPOTENCY_KV=
